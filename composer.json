{
    "name": "xida/remember-the-milk-statistics-frontend",
    "description": "Server-rendered PHP page for the RTM Statistics SQLite snapshots",
    "type": "project",
    "license": "proprietary",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/BenjaminKobjolke/php-localization.git"
        }
    ],
    "require": {
        "php": "^8.5",
        "ext-pdo_sqlite": "*",
        "twig/twig": "^3.30",
        "xida/php-localization": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Tools\\MobileUiDriver\\": "tools/mobile_ui_driver/src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4"
    }
}
